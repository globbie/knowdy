{steward Knowdy Foundational Ontology
         {role Arbiter}
         {db-path /var/lib/knowdy/kfo}
         {schema-path /etc/knowdy/schema
                      {user User
                      {base-repo knd-base
                                 {schema-path /Users/dmitrid/glottie/schemas}}}}
      {-- init-data-path /etc/knowdy/data --}
      {memory
         {main
            {max-large-pages       200}
            {max-base-pages        2500}
            {max-small-x4-pages    1000}
            {max-small-x2-pages    1000}
            {max-small-pages       4000}
            {max-tiny-pages        14000}
         }
         {cache
            {max-large-pages       300 }
            {max-base-pages        5000 }
            {max-small-x4-pages    2000 }
            {max-small-x2-pages    2000 }
            {max-small-pages       6000 }
            {max-tiny-pages        20000 }}
         {user
            {max-large-pages       0 }
            {max-base-pages        320000  }
            {max-small-x4-pages    400000  }
            {max-small-x2-pages    80000   }
            {max-small-pages       3500000 }
            {max-tiny-pages        1700000 }}
         {task-ctx
            {max-large-pages       0 }
            {max-base-pages        10 }
            {max-small-x4-pages    100 }
            {max-small-x2-pages    100 }
            {max-small-pages       100 }
            {max-tiny-pages        1000 }}
         {task-cache
            {max-large-pages        10}
            {max-base-pages        1000}
            {max-small-x4-pages    1000}
            {max-small-x2-pages    1000}
            {max-small-pages       3000}
            {max-tiny-pages        10000}}
      }
      [storage
          {  active
             {type local-fs}
             {mode read-write}
             {quota {unit M}
                    {total 200}}
             {leaf {unit M}
                   {min 20}
                   {max 100}}
             {snapshot
                   {threshold 0.4}}}
          {  archive
             {type local-fs}
             {mode read-only}} ]
      {locale [support { ru } { en } { ja } { en_UK } ]
              [default { ru } ] }
}
