{steward Knowdy Basic
      {role Arbiter}
      {db-path /var/lib/knowdy/db}
      {schema-path /etc/knowdy/schema
           {user User
                 {base-repo knd-base
                       {schema-path /Users/dmitrid/glottie/schemas}}}}
      {-- init-data-path /etc/knowdy/data --}
      {memory
         {main
            {max-large-pages       300}
            {max-base-pages        3000}
            {max-small-x4-pages    1000}
            {max-small-x2-pages    1000}
            {max-small-pages       4000}
            {max-tiny-pages        10000}
         }
         {cache
            {max-large-pages       300}
            {max-base-pages        5000}
            {max-small-x4-pages    2000}
            {max-small-x2-pages    2000}
            {max-small-pages       6000}
            {max-tiny-pages        20000}}
         {user
            {max-base-pages        300000  }
            {max-small-x4-pages    400000  }
            {max-small-x2-pages    80000   }
            {max-small-pages       3500000 }
            {max-tiny-pages        1600000 }}
         {ctx
            {max-large-pages        10}
            {max-base-pages        1000}
            {max-small-x4-pages    1000}
            {max-small-x2-pages    1000}
            {max-small-pages       3000}
            {max-tiny-pages        10000}}
      }
      {storage
          {quota {unit M}
                 {total 200}}
          {leaf {unit M}
                {max 100} {min 20}}
          {snapshot
                {threshold 0.75}}}
}
