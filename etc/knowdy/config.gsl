{schema knd
      {agent public {role Arbiter}}
      {db-path /var/lib/knowdy/db}
      {schema-path /etc/knowdy/schema
           {user User
               {base-repo knd-base
                   {schema-path /etc/knowdy/schema}}}}
      {-- init-data-path /etc/knowdy/data --}
      {memory
         {main
            {max-base-pages        5000}
            {max-small_x4-pages    20000}
            {max-small_x2-pages    31000}
            {max-small-pages       90000}
            {max-tiny-pages        120000}}
         {cache
            {max-base-pages        5000}
            {max-small_x4-pages    20000}
            {max-small_x2-pages    31000}
            {max-small-pages       90000}
            {max-tiny-pages        120000}}
         {user
            {max-base-pages        5000}
            {max-small_x4-pages    20000}
            {max-small_x2-pages    31000}
            {max-small-pages       90000}
            {max-tiny-pages        120000}}
         {ctx
            {max-base-pages        10000}
            {max-small_x4-pages    20000}
            {max-small_x2-pages    31000}
            {max-small-pages       90000}
            {max-tiny-pages        120000}}
      }
      {-- storage   quota-limit-total
                    max-leaf min-leaf
                    snapshot threshhold  min --}
      {-- network --}
}
